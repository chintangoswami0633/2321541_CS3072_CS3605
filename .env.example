# Server Settings
HOST=0.0.0.0
PORT=8000
VERSION=1.0.0

# File Paths
MODEL_DIR=models
CACHE_DIR=cache/images
FRONTEND_DIR=frontend/dist
LOG_LEVEL=INFO

# CORS - Add your frontend URLs here (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting - Requests per minute per IP
RATE_LIMIT_PER_MINUTE=10

# Image Generation Settings
IMAGE_CACHE_TTL_DAYS=7          # How long to keep generated images
MAX_CONCURRENT_JOBS=1            # Images generated at once
MAX_QUEUED_JOBS=10               # Max images in queue
JOB_TIMEOUT_MINUTES=20           # Cancel if taking too long
JOB_RETENTION_MINUTES=60         # Keep completed jobs in memory

# Prediction Cache - How long to cache identical requests (in seconds)
PREDICTION_CACHE_TTL_SECONDS=3600
